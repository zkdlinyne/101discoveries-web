# Supabase — find these in your project at Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — bypasses RLS. NEVER expose to the browser / never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Stripe — server-only secret key (test mode starts with sk_test_). Find it at
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe webhook signing secret (starts with whsec_). For local dev, get it by
# running: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Comma-separated list of emails allowed into the /admin dashboard. These users
# must also exist in Supabase Auth (create them in the Supabase dashboard).
ADMIN_EMAILS=founder@example.com

# Resend — server-only API key for sending confirmation emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# From address. Until you verify your own domain in Resend, use their shared
# sender (onboarding@resend.dev) — note test mode can only send to your own
# Resend account email.
EMAIL_FROM=101 Discoveries <onboarding@resend.dev>

# Optional: base URL used to build Checkout success/cancel links. If unset, the
# app derives it from the incoming request headers (fine for local dev).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
